<component type="desktop-application">
  <id>@app-id@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Vitrine</name>
  <summary>Browse, review and tag your image collection</summary>
  <description>
    <p>
      Vitrine is a fast, focused, catalog-aware image browser and reviewer for
      GNOME. It pairs a GPU-composited viewer with a virtualized thumbnail grid
      and a filmstrip, then adds a catalog and tag layer that survives renames
      and moves — browse images that happen to be files.
    </p>
    <p>Highlights:</p>
    <ul>
      <li>Virtualized thumbnail grid with rubber-band and keyboard selection.</li>
      <li>GPU-composited single-image viewer with zoom, pan and gestures.</li>
      <li>A content-hash keyed index so tags and ratings survive file renames.</li>
      <li>Tags, star ratings, smart collections and hand-curated catalogs.</li>
      <li>Find exact and near-duplicate images.</li>
    </ul>
  </description>
  <launchable type="desktop-id">@app-id@.desktop</launchable>
  <url type="homepage">https://github.com/superuser-miguel/vitrine</url>
  <url type="bugtracker">https://github.com/superuser-miguel/vitrine/issues</url>
  <developer id="io.github.superuser_miguel">
    <name>Miguel Almanzar</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <screenshots>
    <screenshot type="default">
      <image>https://superuser-miguel.github.io/vitrine/screenshots/browser-grid.png</image>
      <caption>Browsing a folder in the virtualized thumbnail grid</caption>
    </screenshot>
    <screenshot>
      <image>https://superuser-miguel.github.io/vitrine/screenshots/viewer-filmstrip.png</image>
      <caption>The single-image viewer with its synced filmstrip</caption>
    </screenshot>
    <screenshot>
      <image>https://superuser-miguel.github.io/vitrine/screenshots/review-properties.png</image>
      <caption>Review and properties sidebar: ratings, comments, EXIF</caption>
    </screenshot>
    <screenshot>
      <image>https://superuser-miguel.github.io/vitrine/screenshots/edit-card.png</image>
      <caption>Non-destructive edit card: rotate, flip, crop, undo/redo</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.3.2" date="2026-10-08">
      <description>
        <p>
          A safety release: saving an edited image no longer risks your tags,
          your file format or the edit itself, and large libraries respond
          faster.
        </p>
        <p>Fixed in this release:</p>
        <ul>
          <li>Saving an edited image keeps the tags and ratings of any other copy of it in your library.</li>
          <li>Save is only offered in place for JPEG and PNG; other formats use Save As with a matching file type, and the dialog says embedded metadata won't be kept.</li>
          <li>Choosing the original file in Save As saves it in place properly, and a failed save now says so.</li>
          <li>Text dragged from a browser onto a catalog is no longer added as an image.</li>
          <li>A scan that fails no longer leaves "Indexing library…" showing.</li>
          <li>A misbehaving sort script can no longer freeze the window.</li>
          <li>Undo and Redo follow the image you're looking at.</li>
          <li>Rating filters, collection counts and opening a tag or collection are much faster in large libraries.</li>
        </ul>
      </description>
    </release>
    <release version="0.3.1" date="2026-10-06">
      <description>
        <p>
          A housekeeping release: Vitrine now keeps its own thumbnails apart
          from the desktop's, cleans up after itself, and remembers more.
        </p>
        <p>New in this release:</p>
        <ul>
          <li>Preferences → Clean Up Thumbnails: remove thumbnails not used in 30, 60, 90 or 180 days, or ones whose image no longer exists. It shows what will go before anything is removed, and never treats a file on an unplugged drive as gone.</li>
          <li>The thumbnail size is remembered between launches.</li>
          <li>Dragging an image that is still being indexed now works, or explains why it can't instead of doing nothing.</li>
        </ul>
        <p>Fixed in this release:</p>
        <ul>
          <li>Vitrine's own large thumbnails were being stored in the desktop's shared cache, and its size limit could prune thumbnails that Files relies on. It now has a private cache and only shares the standard sizes.</li>
          <li>Thumbnail cache folders could end up indexed as photos. They are excluded now, and any that were indexed are removed once, after a backup of the library.</li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2026-10-05">
      <description>
        <p>
          Faster on big and removable libraries, quicker to find things in,
          and the first release on Vitrine's own signed update channel:
          install from the .flatpakref once and later versions arrive with
          flatpak update.
        </p>
        <p>New in this release:</p>
        <ul>
          <li>Find by name: type in the filter bar and the grid narrows to fuzzy matches on file name and path.</li>
          <li>A histogram in Image Properties.</li>
          <li>Thumbnails for USB and network drives are kept between sessions, and recognised again by content even when the drive mounts somewhere else.</li>
          <li>Custom sort orders written as small Lua scripts, reloaded live as you edit them.</li>
          <li>Remove a tag from a whole selection at once, from the grid's Tag popover.</li>
        </ul>
        <p>Fixed in this release:</p>
        <ul>
          <li>The window can be tiled to half the screen again.</li>
          <li>After a fast scroll, thumbnails no longer stay blank while already cached.</li>
          <li>Opening a large folder decodes the visible thumbnails first.</li>
          <li>The grid stops competing with the viewer and filmstrip while an image is open.</li>
          <li>Enriching folders of very large images no longer freezes the app.</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-07-21">
      <description>
        <p>
          A correctness and responsiveness release: the index no longer treats
          unreachable files as deleted, annotations keep working while a scan
          runs, and opening a folder no longer waits behind a background rescan.
        </p>
        <p>New in this release:</p>
        <ul>
          <li>Per-image tags, plus drag and drop from Files onto the viewport.</li>
          <li>Sort by rating or by date taken; a Close Folder button.</li>
          <li>The viewer's folder row browses that folder or opens it in Files.</li>
          <li>Find Duplicates is scoped to the folder you have open.</li>
        </ul>
        <p>Fixed in this release:</p>
        <ul>
          <li>Delete in a catalog no longer trashes the original file.</li>
          <li>Offline and unreadable files are no longer reconciled away.</li>
          <li>Catalog members and drops resolve to durable paths, not stale portal handles.</li>
          <li>Scanning a large library no longer freezes the grid.</li>
          <li>Tag filtering and the tag menu are dramatically faster.</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-07-18">
      <description>
        <p>
          First release. Browse, view, index, review, organize, edit
          (non-destructively) and de-duplicate an image library — all keyed by
          content hash so annotations survive renames and moves.
        </p>
      </description>
    </release>
  </releases>
</component>
